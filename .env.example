# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Flask secret key (generate a strong random string for production)
SECRET_KEY=change-me-to-a-random-secret-string

# --- SMTP / Email settings ---
# Gmail account used to authenticate with the SMTP server
EMAIL_USER=your_gmail@gmail.com

# Gmail App Password (not your regular password).
# Enable 2-Step Verification on your Google Account, then create an App
# Password at https://myaccount.google.com/apppasswords
EMAIL_PASS=your_gmail_app_password

# The address that receives contact-form submissions
ADMIN_EMAIL=your_gmail@gmail.com

# (Optional) Override the From address shown in outgoing emails.
# Must be the same as EMAIL_USER when using Gmail SMTP, unless the
# address is configured as a verified alias in your Gmail settings.
# EMAIL_FROM=your_gmail@gmail.com

# SMTP server and port (defaults below work for Gmail)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
